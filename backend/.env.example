NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Base de datos PostgreSQL (instancia externa)
DB_HOST=tu-host.postgres.example.com
DB_PORT=5432
DB_NAME=gestion_archivos
DB_USER=gestion
DB_PASSWORD=cambia_esta_clave
# true para servicios en la nube (Neon, Supabase, etc.), que exigen SSL
DB_SSL=true

# Autenticación
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# Archivos
MAX_UPLOAD_MB=20
# "s3" (SeaweedFS / AWS S3) o "local" (disco, fuera de cualquier carpeta pública)
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=./storage

S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=gestion-archivos
S3_ACCESS_KEY=dev_access_key
S3_SECRET_KEY=dev_secret_key_change_me
# true para SeaweedFS/MinIO; false para AWS S3
S3_FORCE_PATH_STYLE=true
